{
  "$defs": {
    "ArtifactDigest": {
      "additionalProperties": false,
      "description": "Digest and metadata for a local artifact without location-dependent identity.",
      "properties": {
        "algorithm": {
          "const": "sha256",
          "default": "sha256",
          "title": "Algorithm",
          "type": "string"
        },
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "file_count": {
          "default": 1,
          "minimum": 1,
          "title": "File Count",
          "type": "integer"
        },
        "logical_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logical Name"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "digest",
        "size_bytes"
      ],
      "title": "ArtifactDigest",
      "type": "object"
    },
    "EvidenceAccess": {
      "enum": [
        "declared",
        "outputs",
        "logprobs",
        "internals",
        "artifacts"
      ],
      "title": "EvidenceAccess",
      "type": "string"
    },
    "FileDigestBinding": {
      "additionalProperties": false,
      "description": "Portable location plus digest for one retained regular file.",
      "properties": {
        "logical_name": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Logical Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "maxLength": 2048,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri",
        "sha256",
        "size_bytes",
        "logical_name"
      ],
      "title": "FileDigestBinding",
      "type": "object"
    },
    "ModelFamily": {
      "enum": [
        "llm",
        "vlm",
        "cv",
        "embedding",
        "speech",
        "custom"
      ],
      "title": "ModelFamily",
      "type": "string"
    },
    "ModelRef": {
      "additionalProperties": false,
      "description": "A source reference. Resolution into a snapshot happens separately.",
      "properties": {
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "uri": {
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "uri"
      ],
      "title": "ModelRef",
      "type": "object"
    },
    "ModelSnapshot": {
      "additionalProperties": false,
      "description": "A reproducible, comparable model state.",
      "properties": {
        "artifact_hashes": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactDigest"
          },
          "title": "Artifact Hashes",
          "type": "array"
        },
        "capabilities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "code_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code Revision"
        },
        "config_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Config Fingerprint",
          "type": "string"
        },
        "data_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Revision"
        },
        "evidence_access": {
          "$ref": "#/$defs/EvidenceAccess",
          "default": "declared"
        },
        "id": {
          "pattern": "^mcr:sha256:[a-f0-9]{64}$",
          "title": "Id",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "model_family": {
          "$ref": "#/$defs/ModelFamily",
          "default": "custom"
        },
        "parent_snapshot": {
          "anyOf": [
            {
              "pattern": "^mcr:sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Snapshot"
        },
        "runtime_profile": {
          "$ref": "#/$defs/RuntimeProfile"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ModelRef"
        }
      },
      "required": [
        "id",
        "source",
        "config_fingerprint"
      ],
      "title": "ModelSnapshot",
      "type": "object"
    },
    "RuntimeProfile": {
      "additionalProperties": false,
      "description": "Execution-relevant settings that participate in snapshot identity.",
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Architecture"
        },
        "deterministic": {
          "default": true,
          "title": "Deterministic",
          "type": "boolean"
        },
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        },
        "dtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dtype"
        },
        "framework": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Framework"
        },
        "framework_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Framework Version"
        },
        "operating_system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operating System"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "python_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Python Version"
        },
        "repetitions": {
          "default": 1,
          "minimum": 1,
          "title": "Repetitions",
          "type": "integer"
        },
        "seed": {
          "default": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "title": "RuntimeProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bind a snapshot identity to retained artifact bytes.",
  "properties": {
    "artifacts": {
      "items": {
        "$ref": "#/$defs/FileDigestBinding"
      },
      "maxItems": 1024,
      "minItems": 1,
      "title": "Artifacts",
      "type": "array"
    },
    "id": {
      "pattern": "^mcr:sha256:[a-f0-9]{64}$",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1.0",
      "default": "0.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "snapshot": {
      "$ref": "#/$defs/ModelSnapshot"
    }
  },
  "required": [
    "id",
    "snapshot",
    "artifacts"
  ],
  "title": "SnapshotArtifactManifest",
  "type": "object"
}
