{
  "$defs": {
    "BackendCaseComparison": {
      "additionalProperties": false,
      "description": "One comparator-owned case result with optional measured runtimes.",
      "properties": {
        "baseline_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Latency Ms"
        },
        "candidate_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate Latency Ms"
        },
        "case_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Case Id",
          "type": "string"
        },
        "output_matches": {
          "maxProperties": 256,
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$": {
              "type": "boolean"
            }
          },
          "title": "Output Matches",
          "type": "object"
        }
      },
      "required": [
        "case_id",
        "output_matches"
      ],
      "title": "BackendCaseComparison",
      "type": "object"
    },
    "RuntimeProfile": {
      "additionalProperties": false,
      "description": "Execution-relevant settings that participate in snapshot identity.",
      "properties": {
        "architecture": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Architecture"
        },
        "deterministic": {
          "default": true,
          "title": "Deterministic",
          "type": "boolean"
        },
        "device": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device"
        },
        "dtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dtype"
        },
        "framework": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Framework"
        },
        "framework_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Framework Version"
        },
        "operating_system": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operating System"
        },
        "parameters": {
          "additionalProperties": true,
          "title": "Parameters",
          "type": "object"
        },
        "python_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Python Version"
        },
        "repetitions": {
          "default": 1,
          "minimum": 1,
          "title": "Repetitions",
          "type": "integer"
        },
        "seed": {
          "default": 0,
          "title": "Seed",
          "type": "integer"
        }
      },
      "title": "RuntimeProfile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Bounded, content-addressed backend parity and performance evidence.",
  "properties": {
    "absolute_tolerance": {
      "minimum": 0,
      "title": "Absolute Tolerance",
      "type": "number"
    },
    "baseline_runner": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Baseline Runner",
      "type": "string"
    },
    "baseline_snapshot_id": {
      "pattern": "^mcr:sha256:[a-f0-9]{64}$",
      "title": "Baseline Snapshot Id",
      "type": "string"
    },
    "candidate_runner": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$",
      "title": "Candidate Runner",
      "type": "string"
    },
    "candidate_snapshot_id": {
      "pattern": "^mcr:sha256:[a-f0-9]{64}$",
      "title": "Candidate Snapshot Id",
      "type": "string"
    },
    "case_count": {
      "maximum": 100000,
      "minimum": 1,
      "title": "Case Count",
      "type": "integer"
    },
    "comparator_exit_code": {
      "maximum": 1,
      "minimum": 0,
      "title": "Comparator Exit Code",
      "type": "integer"
    },
    "comparator_name": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Comparator Name",
      "type": "string"
    },
    "comparator_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$",
      "title": "Comparator Version",
      "type": "string"
    },
    "comparisons": {
      "items": {
        "$ref": "#/$defs/BackendCaseComparison"
      },
      "maxItems": 100000,
      "minItems": 1,
      "title": "Comparisons",
      "type": "array"
    },
    "id": {
      "pattern": "^mcr:sha256:[a-f0-9]{64}$",
      "title": "Id",
      "type": "string"
    },
    "limitations": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Limitations",
      "type": "array"
    },
    "matched_case_count": {
      "minimum": 0,
      "title": "Matched Case Count",
      "type": "integer"
    },
    "oracle": {
      "const": "comparator-native",
      "default": "comparator-native",
      "title": "Oracle",
      "type": "string"
    },
    "peak_vram_mib": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Peak Vram Mib"
    },
    "relative_tolerance": {
      "minimum": 0,
      "title": "Relative Tolerance",
      "type": "number"
    },
    "runtime_profile": {
      "$ref": "#/$defs/RuntimeProfile"
    },
    "schema_version": {
      "const": "0.2.0",
      "default": "0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "tool_native_evidence_id": {
      "pattern": "^mcr:sha256:[a-f0-9]{64}$",
      "title": "Tool Native Evidence Id",
      "type": "string"
    },
    "vram_measurement": {
      "default": "unavailable",
      "enum": [
        "nvml-process-peak",
        "unavailable"
      ],
      "title": "Vram Measurement",
      "type": "string"
    }
  },
  "required": [
    "id",
    "comparator_name",
    "comparator_version",
    "comparator_exit_code",
    "baseline_runner",
    "candidate_runner",
    "tool_native_evidence_id",
    "baseline_snapshot_id",
    "candidate_snapshot_id",
    "absolute_tolerance",
    "relative_tolerance",
    "case_count",
    "matched_case_count",
    "comparisons",
    "runtime_profile"
  ],
  "title": "BackendComparisonEvidence",
  "type": "object"
}
