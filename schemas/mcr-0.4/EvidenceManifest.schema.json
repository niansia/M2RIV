{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "A content-addressed evidence edge used by claims and decisions.",
      "properties": {
        "id": {
          "pattern": "^mcr:sha256:[a-f0-9]{64}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        },
        "redacted": {
          "default": false,
          "title": "Redacted",
          "type": "boolean"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "EvidenceSet": {
      "additionalProperties": false,
      "description": "Ordered membership in a reusable set of content-addressed evidence.",
      "properties": {
        "count": {
          "minimum": 1,
          "title": "Count",
          "type": "integer"
        },
        "id": {
          "pattern": "^mcr:sha256:[a-f0-9]{64}$",
          "title": "Id",
          "type": "string"
        },
        "members": {
          "items": {
            "pattern": "^mcr:sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "maxItems": 1000000,
          "minItems": 1,
          "title": "Members",
          "type": "array"
        }
      },
      "required": [
        "id",
        "count",
        "members"
      ],
      "title": "EvidenceSet",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Externalizable evidence index shared by every metric in one MCR.",
  "properties": {
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "maxItems": 1000000,
      "title": "Evidence",
      "type": "array"
    },
    "id": {
      "pattern": "^mcr:sha256:[a-f0-9]{64}$",
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sets": {
      "items": {
        "$ref": "#/$defs/EvidenceSet"
      },
      "maxItems": 4096,
      "minItems": 1,
      "title": "Sets",
      "type": "array"
    }
  },
  "required": [
    "id",
    "evidence",
    "sets"
  ],
  "title": "EvidenceManifest",
  "type": "object"
}
