{
  "$defs": {
    "GateStatus": {
      "description": "Ordered release decision states.",
      "enum": [
        "pass",
        "warn",
        "insufficient_power",
        "block",
        "error"
      ],
      "title": "GateStatus",
      "type": "string"
    },
    "MultipleComparisonMethod": {
      "description": "Policy-wide correction applied to the complete rule family.",
      "enum": [
        "none",
        "holm-bonferroni"
      ],
      "title": "MultipleComparisonMethod",
      "type": "string"
    },
    "RuleDecision": {
      "additionalProperties": false,
      "description": "Auditable outcome of exactly one policy rule.",
      "properties": {
        "adjusted_p_value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Adjusted P Value"
        },
        "confidence_high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence High"
        },
        "confidence_level": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Level"
        },
        "confidence_low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence Low"
        },
        "effect": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect"
        },
        "effective_alpha": {
          "anyOf": [
            {
              "exclusiveMaximum": 1.0,
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Alpha"
        },
        "margin": {
          "title": "Margin",
          "type": "number"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "minimum_detectable_effect": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Minimum Detectable Effect"
        },
        "n_pairs": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Pairs"
        },
        "raw_p_value": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw P Value"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GateStatus"
        },
        "target_power": {
          "anyOf": [
            {
              "exclusiveMaximum": 1.0,
              "exclusiveMinimum": 0.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Power"
        }
      },
      "required": [
        "rule_id",
        "metric",
        "status",
        "reason",
        "margin"
      ],
      "title": "RuleDecision",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Final release outcome with all constituent decisions retained.",
  "properties": {
    "critical_failures": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Critical Failures",
      "type": "array"
    },
    "family_size": {
      "minimum": 1,
      "title": "Family Size",
      "type": "integer"
    },
    "familywise_alpha": {
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Familywise Alpha",
      "type": "number"
    },
    "multiple_comparison_method": {
      "$ref": "#/$defs/MultipleComparisonMethod"
    },
    "policy_id": {
      "minLength": 1,
      "title": "Policy Id",
      "type": "string"
    },
    "rule_decisions": {
      "items": {
        "$ref": "#/$defs/RuleDecision"
      },
      "title": "Rule Decisions",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/GateStatus"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "target_power": {
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.5,
      "title": "Target Power",
      "type": "number"
    }
  },
  "required": [
    "policy_id",
    "status",
    "rule_decisions",
    "multiple_comparison_method",
    "familywise_alpha",
    "family_size",
    "target_power",
    "summary"
  ],
  "title": "GateDecision",
  "type": "object"
}
