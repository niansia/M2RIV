{
  "$defs": {
    "GateRule": {
      "additionalProperties": false,
      "description": "A non-inferiority rule evaluated against the entire confidence interval.",
      "properties": {
        "block_on_violation": {
          "default": true,
          "title": "Block On Violation",
          "type": "boolean"
        },
        "direction": {
          "$ref": "#/$defs/MetricDirection",
          "default": "higher_is_better"
        },
        "margin": {
          "minimum": 0.0,
          "title": "Margin",
          "type": "number"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "min_pairs": {
          "default": 30,
          "minimum": 1,
          "title": "Min Pairs",
          "type": "integer"
        },
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "metric",
        "margin"
      ],
      "title": "GateRule",
      "type": "object"
    },
    "MetricDirection": {
      "description": "Whether larger or smaller metric values are preferable.",
      "enum": [
        "higher_is_better",
        "lower_is_better"
      ],
      "title": "MetricDirection",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A versioned collection of release rules.",
  "properties": {
    "allow_warn": {
      "default": false,
      "title": "Allow Warn",
      "type": "boolean"
    },
    "block_on_any_critical_failure": {
      "default": true,
      "title": "Block On Any Critical Failure",
      "type": "boolean"
    },
    "insufficient_evidence_status": {
      "default": "warn",
      "enum": [
        "warn",
        "error"
      ],
      "title": "Insufficient Evidence Status",
      "type": "string"
    },
    "policy_id": {
      "minLength": 1,
      "title": "Policy Id",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/GateRule"
      },
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "policy_id",
    "rules"
  ],
  "title": "GatePolicy",
  "type": "object"
}
