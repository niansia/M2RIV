{
  "$defs": {
    "GateRule": {
      "additionalProperties": false,
      "description": "A non-inferiority rule evaluated against the entire confidence interval.",
      "properties": {
        "block_on_violation": {
          "default": true,
          "title": "Block On Violation",
          "type": "boolean"
        },
        "direction": {
          "$ref": "#/$defs/MetricDirection",
          "default": "higher_is_better"
        },
        "margin": {
          "minimum": 0.0,
          "title": "Margin",
          "type": "number"
        },
        "max_mde": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Mde"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "min_pairs": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Pairs"
        },
        "planned_difference_stddev": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Planned Difference Stddev"
        },
        "rule_id": {
          "minLength": 1,
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "metric",
        "margin"
      ],
      "title": "GateRule",
      "type": "object"
    },
    "MetricDirection": {
      "description": "Whether larger or smaller metric values are preferable.",
      "enum": [
        "higher_is_better",
        "lower_is_better"
      ],
      "title": "MetricDirection",
      "type": "string"
    },
    "MultipleComparisonMethod": {
      "description": "Policy-wide correction applied to the complete rule family.",
      "enum": [
        "none",
        "holm-bonferroni"
      ],
      "title": "MultipleComparisonMethod",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A versioned collection of release rules.",
  "properties": {
    "allow_warn": {
      "default": false,
      "title": "Allow Warn",
      "type": "boolean"
    },
    "block_on_any_critical_failure": {
      "default": true,
      "title": "Block On Any Critical Failure",
      "type": "boolean"
    },
    "familywise_alpha": {
      "default": 0.05,
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.0,
      "title": "Familywise Alpha",
      "type": "number"
    },
    "insufficient_evidence_status": {
      "default": "insufficient_power",
      "enum": [
        "insufficient_power",
        "warn",
        "error"
      ],
      "title": "Insufficient Evidence Status",
      "type": "string"
    },
    "multiple_comparison_method": {
      "$ref": "#/$defs/MultipleComparisonMethod",
      "default": "holm-bonferroni"
    },
    "policy_id": {
      "minLength": 1,
      "title": "Policy Id",
      "type": "string"
    },
    "rules": {
      "items": {
        "$ref": "#/$defs/GateRule"
      },
      "minItems": 1,
      "title": "Rules",
      "type": "array"
    },
    "schema_version": {
      "default": "1.1.0",
      "enum": [
        "1.0.0",
        "1.1.0"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "target_power": {
      "default": 0.8,
      "exclusiveMaximum": 1.0,
      "exclusiveMinimum": 0.5,
      "title": "Target Power",
      "type": "number"
    }
  },
  "required": [
    "policy_id",
    "rules"
  ],
  "title": "GatePolicy",
  "type": "object"
}
