{
  "$defs": {
    "NamedCountChange": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "minimum": 0,
          "title": "Baseline",
          "type": "integer"
        },
        "candidate": {
          "minimum": 0,
          "title": "Candidate",
          "type": "integer"
        },
        "delta": {
          "title": "Delta",
          "type": "integer"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,255}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "baseline",
        "candidate",
        "delta"
      ],
      "title": "NamedCountChange",
      "type": "object"
    },
    "OpsetChange": {
      "additionalProperties": false,
      "properties": {
        "baseline": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        },
        "candidate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Candidate"
        },
        "domain": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,255}$",
          "title": "Domain",
          "type": "string"
        }
      },
      "required": [
        "domain"
      ],
      "title": "OpsetChange",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_changed": {
      "title": "Artifact Changed",
      "type": "boolean"
    },
    "baseline_profile_id": {
      "pattern": "^mcr:sha256:[a-f0-9]{64}$",
      "title": "Baseline Profile Id",
      "type": "string"
    },
    "candidate_profile_id": {
      "pattern": "^mcr:sha256:[a-f0-9]{64}$",
      "title": "Candidate Profile Id",
      "type": "string"
    },
    "changed_components": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/+-]{0,255}$",
        "type": "string"
      },
      "maxItems": 128,
      "title": "Changed Components",
      "type": "array"
    },
    "external_data_changed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "External Data Changed"
    },
    "file_count_delta": {
      "title": "File Count Delta",
      "type": "integer"
    },
    "format_changed": {
      "title": "Format Changed",
      "type": "boolean"
    },
    "id": {
      "pattern": "^mcr:sha256:[a-f0-9]{64}$",
      "title": "Id",
      "type": "string"
    },
    "initializer_count_delta": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Initializer Count Delta"
    },
    "initializer_dtype_changes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/NamedCountChange"
      },
      "maxItems": 128,
      "title": "Initializer Dtype Changes",
      "type": "array"
    },
    "inputs_changed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inputs Changed"
    },
    "node_count_delta": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Node Count Delta"
    },
    "operator_changes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/NamedCountChange"
      },
      "maxItems": 4096,
      "title": "Operator Changes",
      "type": "array"
    },
    "opset_changes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OpsetChange"
      },
      "maxItems": 64,
      "title": "Opset Changes",
      "type": "array"
    },
    "outputs_changed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outputs Changed"
    },
    "parameter_count_delta": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parameter Count Delta"
    },
    "quantization_format_changed": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quantization Format Changed"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "size_delta_bytes": {
      "title": "Size Delta Bytes",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "baseline_profile_id",
    "candidate_profile_id",
    "artifact_changed",
    "format_changed",
    "size_delta_bytes",
    "file_count_delta"
  ],
  "title": "ArtifactDiff",
  "type": "object"
}
