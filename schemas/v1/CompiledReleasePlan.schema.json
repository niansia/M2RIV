{
  "$defs": {
    "MetricDirection": {
      "description": "Whether larger or smaller metric values are preferable.",
      "enum": [
        "higher_is_better",
        "lower_is_better"
      ],
      "title": "MetricDirection",
      "type": "string"
    },
    "PlannedMetric": {
      "additionalProperties": false,
      "properties": {
        "base_metric_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Base Metric Id",
          "type": "string"
        },
        "binary": {
          "title": "Binary",
          "type": "boolean"
        },
        "direction": {
          "$ref": "#/$defs/MetricDirection"
        },
        "metric_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@=/-]{0,383}$",
          "title": "Metric Id",
          "type": "string"
        },
        "plugin_name": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plugin Name"
        },
        "plugin_version": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plugin Version"
        },
        "scope": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@=/-]{0,383}$",
          "title": "Scope",
          "type": "string"
        },
        "unit": {
          "pattern": "^[!-~][ -~]{0,63}$",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "metric_id",
        "base_metric_id",
        "scope",
        "direction",
        "unit",
        "binary"
      ],
      "title": "PlannedMetric",
      "type": "object"
    },
    "PluginRecord": {
      "additionalProperties": false,
      "description": "Exact plugin provenance captured for replay and audit.",
      "properties": {
        "api_version": {
          "default": "0.1",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$",
          "title": "Api Version",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "config_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Config Fingerprint",
          "type": "string"
        },
        "kind": {
          "default": "unknown",
          "enum": [
            "adapter",
            "metric",
            "executor",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "config_fingerprint"
      ],
      "title": "PluginRecord",
      "type": "object"
    },
    "RuleBinding": {
      "additionalProperties": false,
      "properties": {
        "base_metric_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Base Metric Id",
          "type": "string"
        },
        "metric_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@=/-]{0,383}$",
          "title": "Metric Id",
          "type": "string"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@=/-]{0,383}$",
          "title": "Rule Id",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "metric_id",
        "base_metric_id"
      ],
      "title": "RuleBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Preflight proof that a policy can be evaluated by the declared metrics.",
  "properties": {
    "bindings": {
      "items": {
        "$ref": "#/$defs/RuleBinding"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Bindings",
      "type": "array"
    },
    "confidence_level": {
      "exclusiveMaximum": 1,
      "exclusiveMinimum": 0,
      "title": "Confidence Level",
      "type": "number"
    },
    "id": {
      "pattern": "^m2riv:sha256:[a-f0-9]{64}$",
      "title": "Id",
      "type": "string"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/PlannedMetric"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    },
    "plugins": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PluginRecord"
      },
      "maxItems": 128,
      "title": "Plugins",
      "type": "array"
    },
    "policy_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Policy Fingerprint",
      "type": "string"
    },
    "policy_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@=/-]{0,383}$",
      "title": "Policy Id",
      "type": "string"
    },
    "resamples": {
      "minimum": 1,
      "title": "Resamples",
      "type": "integer"
    },
    "runtime_profile_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Runtime Profile Fingerprint",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "slice_keys": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
        "type": "string"
      },
      "maxItems": 32,
      "title": "Slice Keys",
      "type": "array"
    },
    "suite_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Suite Fingerprint",
      "type": "string"
    }
  },
  "required": [
    "id",
    "policy_id",
    "policy_fingerprint",
    "suite_fingerprint",
    "runtime_profile_fingerprint",
    "seed",
    "resamples",
    "confidence_level",
    "metrics",
    "bindings"
  ],
  "title": "CompiledReleasePlan",
  "type": "object"
}
