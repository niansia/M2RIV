{
  "$defs": {
    "ConformanceProfile": {
      "additionalProperties": false,
      "description": "One normative PASS/WARN/BLOCK interoperability observation.",
      "properties": {
        "decision_status": {
          "$ref": "#/$defs/MCRStatus"
        },
        "profile": {
          "enum": [
            "pass",
            "warn",
            "block"
          ],
          "title": "Profile",
          "type": "string"
        },
        "release_authorized": {
          "title": "Release Authorized",
          "type": "boolean"
        },
        "report_id": {
          "pattern": "^m2riv:sha256:[a-f0-9]{64}$",
          "title": "Report Id",
          "type": "string"
        }
      },
      "required": [
        "profile",
        "report_id",
        "decision_status",
        "release_authorized"
      ],
      "title": "ConformanceProfile",
      "type": "object"
    },
    "MCRStatus": {
      "enum": [
        "PASS",
        "WARN",
        "BLOCK",
        "ERROR"
      ],
      "title": "MCRStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Portable receipt emitted by an MCR consumer over the normative fixtures.",
  "properties": {
    "id": {
      "pattern": "^m2riv:sha256:[a-f0-9]{64}$",
      "title": "Id",
      "type": "string"
    },
    "implementation_name": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Implementation Name",
      "type": "string"
    },
    "implementation_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$",
      "title": "Implementation Version",
      "type": "string"
    },
    "profiles": {
      "items": {
        "$ref": "#/$defs/ConformanceProfile"
      },
      "maxItems": 3,
      "minItems": 3,
      "title": "Profiles",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "implementation_name",
    "implementation_version",
    "profiles"
  ],
  "title": "ConsumerConformanceReceipt",
  "type": "object"
}
