{
  "$defs": {
    "RetentionMode": {
      "enum": [
        "full",
        "redacted",
        "hash_only"
      ],
      "title": "RetentionMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Raw evidence produced by running one snapshot on one case.",
  "properties": {
    "attempt": {
      "default": 0,
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "id": {
      "pattern": "^m2riv:sha256:[a-f0-9]{64}$",
      "title": "Id",
      "type": "string"
    },
    "latency_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Latency Ms"
    },
    "output": {
      "anyOf": [
        {},
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Output"
    },
    "output_digest": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Output Digest",
      "type": "string"
    },
    "retention": {
      "$ref": "#/$defs/RetentionMode",
      "default": "full"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "snapshot_id": {
      "pattern": "^m2riv:sha256:[a-f0-9]{64}$",
      "title": "Snapshot Id",
      "type": "string"
    },
    "traces": {
      "additionalProperties": true,
      "title": "Traces",
      "type": "object"
    }
  },
  "required": [
    "id",
    "snapshot_id",
    "case_id",
    "output_digest"
  ],
  "title": "Observation",
  "type": "object"
}
