{
  "$defs": {
    "MCRStatus": {
      "enum": [
        "PASS",
        "WARN",
        "BLOCK",
        "ERROR"
      ],
      "title": "MCRStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Machine-readable result from verifying one MCR bundle.",
  "properties": {
    "authenticity_verified": {
      "default": false,
      "title": "Authenticity Verified",
      "type": "boolean"
    },
    "checks": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "decision_status": {
      "$ref": "#/$defs/MCRStatus"
    },
    "integrity_valid": {
      "default": true,
      "title": "Integrity Valid",
      "type": "boolean"
    },
    "report_id": {
      "pattern": "^m2riv:sha256:[a-f0-9]{64}$",
      "title": "Report Id",
      "type": "string"
    },
    "run_id": {
      "pattern": "^m2riv:sha256:[a-f0-9]{64}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.2.0",
      "default": "1.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trust_scope": {
      "const": "self-consistency-only",
      "default": "self-consistency-only",
      "title": "Trust Scope",
      "type": "string"
    },
    "unverified_evidence_count": {
      "minimum": 0,
      "title": "Unverified Evidence Count",
      "type": "integer"
    },
    "valid": {
      "default": true,
      "title": "Valid",
      "type": "boolean"
    },
    "verification_complete": {
      "title": "Verification Complete",
      "type": "boolean"
    },
    "verification_scope": {
      "const": "report-and-local-bundle",
      "default": "report-and-local-bundle",
      "title": "Verification Scope",
      "type": "string"
    },
    "verified_evidence_count": {
      "minimum": 0,
      "title": "Verified Evidence Count",
      "type": "integer"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "verification_complete",
    "verified_evidence_count",
    "unverified_evidence_count",
    "report_id",
    "run_id",
    "decision_status",
    "checks"
  ],
  "title": "MCRVerification",
  "type": "object"
}
