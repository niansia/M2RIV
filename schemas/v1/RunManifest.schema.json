{
  "$defs": {
    "PluginRecord": {
      "additionalProperties": false,
      "description": "Exact plugin provenance captured for replay and audit.",
      "properties": {
        "api_version": {
          "default": "0.1",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$",
          "title": "Api Version",
          "type": "string"
        },
        "capabilities": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Capabilities",
          "type": "array",
          "uniqueItems": true
        },
        "config_fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Config Fingerprint",
          "type": "string"
        },
        "kind": {
          "default": "unknown",
          "enum": [
            "adapter",
            "metric",
            "executor",
            "unknown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]{0,63}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "config_fingerprint"
      ],
      "title": "PluginRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable provenance for one paired comparison run.",
  "properties": {
    "baseline_snapshot_id": {
      "pattern": "^m2riv:sha256:[a-f0-9]{64}$",
      "title": "Baseline Snapshot Id",
      "type": "string"
    },
    "candidate_snapshot_ids": {
      "items": {
        "pattern": "^m2riv:sha256:[a-f0-9]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Candidate Snapshot Ids",
      "type": "array"
    },
    "case_count": {
      "default": 0,
      "minimum": 0,
      "title": "Case Count",
      "type": "integer"
    },
    "code_revision": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Code Revision"
    },
    "config_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Config Fingerprint",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "dependencies": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Dependencies",
      "type": "object"
    },
    "environment": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Environment",
      "type": "object"
    },
    "plugins": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PluginRecord"
      },
      "maxItems": 128,
      "title": "Plugins",
      "type": "array"
    },
    "run_id": {
      "pattern": "^m2riv:sha256:[a-f0-9]{64}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "default": 0,
      "title": "Seed",
      "type": "integer"
    },
    "suite_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Suite Fingerprint",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "baseline_snapshot_id",
    "candidate_snapshot_ids",
    "suite_fingerprint",
    "config_fingerprint"
  ],
  "title": "RunManifest",
  "type": "object"
}
